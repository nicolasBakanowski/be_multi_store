# Copiar a .env.production y completar antes de `make up-prod` / compose prod
# Nunca commitear .env.production con secretos reales.

PORT=30001
SECRET_KEY=
MYSQL_URL=mysql://USER:PASSWORD@db:3306/DATABASE
CORS_ORIGINS=https://tu-dominio.com

REDIS_URL=redis://redis:6379
# GOOGLE_CLIENT_ID=
SOCKET_AUTH_REQUIRED=true
SWAGGER_ENABLED=false

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

API_IMAGE_NAME=multistore-api
API_IMAGE_TAG=prod
