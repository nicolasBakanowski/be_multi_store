NODE_ENV=test

# MySQL (docker-compose.integration.yml expone 3307)
MYSQL_ROOT_PASSWORD=testroot
MYSQL_DATABASE=multistore_test
MYSQL_USER=multistore
MYSQL_PASSWORD=multistore
MYSQL_PORT=3307

DB_HOST=127.0.0.1

# App usa MYSQL_URL
MYSQL_URL=mysql://multistore:multistore@127.0.0.1:3307/multistore_test

# JWT secret (backend soporta SECRET_KEY o JWT_SECRET)
SECRET_KEY=test-secret-key-for-integration-32chars

