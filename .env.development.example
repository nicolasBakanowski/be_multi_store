# Copiar a .env.development (make up lo crea desde este ejemplo si falta)
# Variables usadas por docker compose (interpolación) y por el contenedor API

PORT=30001
SECRET_KEY=cambiar-en-desarrollo-minimo-32-caracteres-recomendado
MYSQL_URL=mysql://multistore:multistore@db:3306/multistore
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis (BullMQ). En Docker: redis://redis:6379
REDIS_URL=redis://redis:6379

# Google Sign-In (opcional). Si está definido, /user/authGoogle exige JWT en body.credential
# GOOGLE_CLIENT_ID=

# Socket.IO: exigir JWT en handshake (auth.token o Authorization Bearer)
SOCKET_AUTH_REQUIRED=false

# En producción Swagger está apagado salvo SWAGGER_ENABLED=true
# SWAGGER_ENABLED=false

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=devroot
MYSQL_DATABASE=multistore
MYSQL_USER=multistore
MYSQL_PASSWORD=multistore
